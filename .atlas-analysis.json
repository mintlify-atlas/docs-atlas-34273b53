  "keyFeatures": [
    "Pre-execution policy enforcement with PERMIT/DENY/DEFER",
    "Policy-as-code with YAML and expr-lang expressions",
    "Tamper-evident DPR chain for audit trail",
    "Human-in-the-loop DEFER workflow",
    "Multiple adapter modes (SDK, daemon, sidecar, serverless, MCP, eBPF)",
    "WAL-first architecture for audit integrity",
    "Multi-agent governance and session management",
    "Zero-config development mode"
  ],
  "publicApiSurface": [
    "govern() - Python decorator for tool governance",
    "faramesh demo - See governance in action",
    "faramesh init - Auto-detect environment and generate config",
    "faramesh serve - Start governance daemon",
    "faramesh policy validate - Validate policy files",
    "faramesh audit tail - Stream live decisions",
    "faramesh agent approve - Approve deferred actions",
    "faramesh agent deny - Deny deferred actions",
    "faramesh agent kill - Activate kill switch",
    "CanonicalActionRequest - Core request type",
    "Decision - Governance decision output",
    "Effect - PERMIT/DENY/DEFER/SHADOW"
  ]
